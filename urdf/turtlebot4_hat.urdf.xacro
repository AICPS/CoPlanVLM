<?xml version="1.0" ?>
<!--
  Drop-in replacement for turtlebot4.urdf.xacro that adds a colored "hat" disk on top of
  the robot for overhead identification (so the VLM can tell two robots apart).

  Usage (same args as the stock description, plus hat_color RGBA):
    xacro turtlebot4_hat.urdf.xacro gazebo:=ignition namespace:=raph2 hat_color:='0 0 1 1'

  gazebo/namespace args are declared by the included standard description; we only add
  hat_color here.
-->
<robot name="turtlebot4" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- RGBA color of the overhead marker disk (default blue) -->
  <xacro:arg name="hat_color" default="0 0 1 1"/>

  <!-- The complete standard TurtleBot 4 (passes through gazebo:= and namespace:=) -->
  <xacro:include filename="$(find turtlebot4_description)/urdf/standard/turtlebot4.urdf.xacro"/>

  <!-- Colored marker disk, fixed on top of the shell dome -->
  <link name="hat_link">
    <visual>
      <geometry>
        <cylinder radius="0.12" length="0.02"/>
      </geometry>
      <material name="hat_material">
        <color rgba="$(arg hat_color)"/>
      </material>
    </visual>
  </link>

  <joint name="hat_joint" type="fixed">
    <parent link="shell_link"/>
    <child link="hat_link"/>
    <origin xyz="0 0 0.26" rpy="0 0 0"/>
  </joint>

  <!-- Ignition/Gazebo material (this is what the sim renders) -->
  <gazebo reference="hat_link">
    <visual>
      <material>
        <ambient>$(arg hat_color)</ambient>
        <diffuse>$(arg hat_color)</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

</robot>
