<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>coplan_vlm</name>
  <version>0.0.0</version>
  <description>TurtleBot control w/ OpenAI API (adaptive Executive path planner)</description>
  <maintainer email="davidrm3@uci.edu">David</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>turtlebot4_msgs</exec_depend>
  <exec_depend>turtlebot4_gazebo</exec_depend>
  <exec_depend>turtlebot4_ignition</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-dotenv</exec_depend>
  <!-- openai is pip-only (no rosdep key exists); it is declared in requirements.txt instead. -->


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>