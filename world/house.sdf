      <pose>0.50 -3.38 0.94 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 2.25 1.88</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.25 1.88</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Camera: height 7.5 → 5.0 -->
    <model name="ids_camera">
      <!-- moved slightly higher to increase top/bottom coverage -->
      <pose>0 0 10 0 1.5708 1.5708</pose>
      <static>true</static>
      <link name="camera_link">
        <visual name="camera_body_visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <visual name="camera_axis">
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <pose>0 0 0 0 1.5708 0</pose>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        <sensor name='ids_overhead' type='camera'>
          <always_on>true</always_on>
          <update_rate>47</update_rate>
          <visualize>true</visualize>
          <pose>0 0 0 0 0 0</pose>
          <topic>/ids_overhead/image</topic>
          <camera name='overhead_cam'>
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>1936</width>
              <height>1216</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>


