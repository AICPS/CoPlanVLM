<?xml version="1.0"?>
<sdf version="1.9">
  <world name="house">
    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="ignition::gazebo::systems::Physics" filename="libignition-gazebo-physics-system.so"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="libignition-gazebo-user-commands-system.so"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="libignition-gazebo-scene-broadcaster-system.so"/>
    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.85 0.90 0.95 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun_light">
      <pose>0 0 7 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.1 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- Floor: 18x18 → 9x9 -->
    <model name="house_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="floor_link">
        <collision name="collision">
          <geometry><box><size>9 9 0.04</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9 9 0.04</size></box></geometry>
          <material>
            <ambient>0.88 0.84 0.76 1</ambient>
            <diffuse>0.88 0.84 0.76 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer walls: scaled to fit the smaller house footprint -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.5 0.94 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9 0.19 1.88</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>9 0.19 1.88</size></box></geometry>
          <material><ambient>0.95 0.95 0.92 1</ambient><diffuse>0.95 0.95 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.5 0.94 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9 0.19 1.88</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>9 0.19 1.88</size></box></geometry>
          <material><ambient>0.95 0.95 0.92 1</ambient><diffuse>0.95 0.95 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>4.5 0 0.94 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.19 9 1.88</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.19 9 1.88</size></box></geometry>
          <material><ambient>0.95 0.95 0.92 1</ambient><diffuse>0.95 0.95 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-4.5 0 0.94 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.19 9 1.88</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.19 9 1.88</size></box></geometry>
          <material><ambient>0.95 0.95 0.92 1</ambient><diffuse>0.95 0.95 0.92 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Inner walls: poses and sizes scaled with the house footprint -->
    <model name="inner_wall_top_left">
      <static>true</static>
      <pose>-2.00 0 0.94 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.00 0.15 1.88</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.00 0.15 1.88</size></box></geometry>
