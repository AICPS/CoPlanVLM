    </model>
    <model name="inner_wall_vertical_top">
      <static>true</static>
      <pose>0.50 2.87 0.94 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 2.25 1.88</size></box></geometry></collision>
